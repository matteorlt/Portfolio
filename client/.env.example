# Copiez vers .env ou .env.local dans ce dossier.
# Voir ../.env.example à la racine pour les détails.

# Public (inclus dans le build Vite — OK pour le site)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CONTACT_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Privée — jamais de préfixe VITE_ — pour npm run test:email uniquement
EMAILJS_PRIVATE_KEY=
