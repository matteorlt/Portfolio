# =============================================================================
# Portfolio — variables pour le FRONTEND (Vite)
# =============================================================================
# Copiez ce fichier vers client/.env ou client/.env.local pour le dev local.
# Sur Vercel : Settings → Environment Variables — ajoutez les clés VITE_* pour
# Production et Preview.
#
# Les formulaires Contact et Offres envoient les emails via EmailJS uniquement.
# https://www.emailjs.com/
# =============================================================================

# --- Obligatoire (site + build) ---
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Template page Contact (champs : from_name, from_email, reply_to, subject, message,
#   project_type, project_type_key)
VITE_EMAILJS_TEMPLATE_CONTACT_ID=

# Template page Offres / devis (prioritaire si défini ; sinon VITE_EMAILJS_TEMPLATE_ID)
VITE_EMAILJS_TEMPLATE_DEVIS_ID=

# Rétrocompat : utilisé si CONTACT / DEVIS ne sont pas renseignés
VITE_EMAILJS_TEMPLATE_ID=

# =============================================================================
# Clé privée — UNIQUEMENT hors navigateur (script de test npm run test:email)
# =============================================================================
# Ne préfixez PAS par VITE_ (sinon la clé partirait dans le JS public).
# Dashboard EmailJS → Account → API keys → Private Key
# Requise si « Use Private Key » / mode strict est activé pour les appels API.
EMAILJS_PRIVATE_KEY=

# --- Test des envois ---
# cd client && npm run test:email
# cd client && npm run test:email:quote
# 403 « non-browser » : EmailJS → Account → Security → API hors navigateur
# Erreur strict mode : renseigner EMAILJS_PRIVATE_KEY ci-dessus
